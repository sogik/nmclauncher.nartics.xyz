---
import { Image } from "astro:assets";
import "../styles/reset.css";
import "../styles/root.css";
import "../styles/fonts.css";
import "../styles/elements.css";
import "../styles/button.css";
import "../styles/footer.css";
import "../styles/header.css";
import "../styles/main.css";
import "../styles/nav.css";
import "../styles/pre.css";
import "../styles/workstations.css";

const title = "Login Successful - NMCLauncher";
import darkLogo from "../assets/NMCLauncher.header.darkmode.svg";
import lightLogo from "../assets/NMCLauncher.header.source.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Login Successful" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap"
      rel="stylesheet"
    />
    <style>
      /* Page specific styles */
      .success-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 50vh;
        text-align: center;
        padding: 20px;
        animation: fadeIn 0.5s ease-out;
      }
      
      .success-icon {
        width: 80px;
        height: 80px;
        color: var(--brand-orange);
        margin-bottom: 20px;
      }

      h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 15px;
        color: var(--text-main);
      }

      p {
        font-size: 1.1rem;
        color: var(--text-main);
        opacity: 0.8;
        margin-bottom: 30px;
        max-width: 500px;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }
    </style>
    <style is:global>
       /* Copied Global Styles for consistency */
      :root {
        --brand-orange: #f97316;
        --brand-orange-dark: #ea580c;
        --bg-main: #0a0a0a;
        --text-main: #f3f4f6;
        --card-border: #333;
        --card-bg: rgba(255, 255, 255, 0.02);
        --button-hover-bg: rgba(249, 115, 22, 0.05);
      }

      [data-theme="light"] {
        --bg-main: #ffffff;
        --text-main: #171717;
        --card-border: #e5e7eb;
        --card-bg: #f9fafb;
        --button-hover-bg: rgba(249, 115, 22, 0.1);
      }

      body {
        background-color: var(--bg-main);
        color: var(--text-main);
        font-family: "Outfit", sans-serif;
        font-weight: 400;
        transition: background-color 0.3s ease, color 0.3s ease;
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      #theme-toggle {
        position: absolute;
        top: 30px;
        right: 30px;
        background: transparent;
        border: 1px solid var(--card-border);
        color: var(--text-main);
        padding: 10px;
        border-radius: 50%;
        cursor: pointer;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
      }
      #theme-toggle:hover {
        border-color: var(--brand-orange);
        color: var(--brand-orange);
        background-color: var(--button-hover-bg);
      }
      #theme-toggle svg {
        width: 24px;
        height: 24px;
        fill: currentColor;
      }
      
      .logo-img {
        width: 100%;
        max-width: 400px;
        height: auto;
        display: inline-block;
        margin-top: 40px;
      }
      .logo-light { display: none !important; }
      .logo-dark { display: inline-block !important; }
      [data-theme="light"] .logo-light { display: inline-block !important; }
      [data-theme="light"] .logo-dark { display: none !important; }
      
      .footer {
        margin-top: auto;
        width: 100%;
        text-align: center;
        display: block; /* Override grid if it causes issues */
      }

      .footer p {
        color: var(--text-main);
      }

      .footer__buttons a {
        color: var(--text-main);
        transition: color 0.3s;
        display: inline-block;
      }
      .footer__buttons a:hover {
        color: var(--brand-orange);
      }
    </style>
  </head>
  <body>
    <!-- Theme Toggle -->
    <button id="theme-toggle" aria-label="Toggle Dark/Light Mode">
      <svg id="icon-sun" viewBox="0 0 24 24"><path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 000-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 000-1.41.996.996 0 00-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 000 1.41.996.996 0 001.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06z"></path></svg>
      <svg id="icon-moon" viewBox="0 0 24 24" style="display:none;"><path d="M9.37 5.51A7.35 7.35 0 009.1 7.5c0 4.08 3.32 7.4 7.4 7.4.68 0 1.35-.09 1.99-.27C17.45 17.16 14.93 19 12 19c-4.41 0-8-3.59-8-8 0-3.2 2.11-5.98 5.37-7.49zM12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"></path></svg>
    </button>

    <div style="text-align: center; padding: 20px;">
      <a href="/">
        <Image src={darkLogo} alt="NMCLauncher Logo" width={400} height={100} class="logo-img logo-dark" loading="eager" />
        <Image src={lightLogo} alt="NMCLauncher Logo" width={400} height={100} class="logo-img logo-light" loading="eager" />
      </a>
    </div>

    <main class="success-container">
      <svg class="success-icon" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
      </svg>
      
      <h1>Login Successful</h1>
      <p>Welcome back! You have successfully signed in to your account.</p>
    </main>

    <footer class="footer">
      <div class="footer__subhead">
        <p>
          Made by <a
            href="https://x.com/sogikz"
            style="color: var(--brand-orange);">sogik</a
          >
        </p>
      </div>
    </footer>

    <script src="../scripts/main.ts"></script>
  </body>
</html>
