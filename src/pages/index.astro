---
import { Image } from "astro:assets";
import "../styles/reset.css";
import "../styles/root.css";
import "../styles/fonts.css";
import "../styles/elements.css";
import "../styles/button.css";
import "../styles/footer.css";
import "../styles/header.css";
import "../styles/main.css";
import "../styles/nav.css";
import "../styles/pre.css";
import "../styles/workstations.css";

const title = "NMCLauncher";
import darkLogo from "../assets/NMCLauncher.header.darkmode.svg";
import lightLogo from "../assets/NMCLauncher.header.source.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="DRM-free Prism Launcher fork" />

    <meta property="og:site_name" content="NMCLauncher" />
    <meta property="og:title" content="NMCLauncher" />
    <meta property="og:description" content="DRM-free Prism Launcher fork" />
    <meta property="og:image" content="favicon.svg" />
    <meta property="og:url" content="https://nmclauncher.nartics.xyz" />
    <meta property="og:type" content="website" />

    <title>{title}</title>
    <link rel="icon" href="favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --brand-orange: #f97316;
        --brand-orange-dark: #ea580c;
        --bg-main: #0a0a0a;
        --text-main: #f3f4f6;
        --card-border: #333;
        --card-bg: rgba(255, 255, 255, 0.02);
        --button-hover-bg: rgba(249, 115, 22, 0.05);
      }

      [data-theme="light"] {
        --bg-main: #ffffff;
        --text-main: #171717;
        --card-border: #e5e7eb;
        --card-bg: #f9fafb;
        --button-hover-bg: rgba(249, 115, 22, 0.1);
      }

      body {
        background-color: var(--bg-main);
        color: var(--text-main);
        /* APLICAR FUENTE OUTFIT */
        font-family: "Outfit", sans-serif;
        font-weight: 400;
        transition:
          background-color 0.3s ease,
          color 0.3s ease;
        position: relative;
      }

      .footer p {
        color: var(--text-main);
      }

      .notification {
        background-color: var(--brand-orange) !important;
        border-bottom: 1px solid var(--brand-orange-dark) !important;
        text-align: center;
        padding: 12px;
        font-weight: 800;
        font-size: 0.95rem;
        position: relative;
        z-index: 100;
        letter-spacing: 0.5px;
      }
      .notification a {
        color: #000 !important;
        text-decoration: none;
      }
      .notification a:hover {
        text-decoration: underline;
        color: #000 !important;
      }

      #theme-toggle {
        position: absolute;
        top: 50px;
        right: 30px;
        background: transparent;
        border: 1px solid var(--card-border);
        color: var(--text-main);
        padding: 10px;
        border-radius: 50%;
        cursor: pointer;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
      }
      #theme-toggle:hover {
        border-color: var(--brand-orange);
        color: var(--brand-orange);
        background-color: var(--button-hover-bg);
      }
      #theme-toggle svg {
        width: 24px;
        height: 24px;
        fill: currentColor;
      }

      .logo-img {
        width: 100%;
        max-width: 800px;
        height: auto;
        display: inline-block;
      }
      .logo-light {
        display: none !important;
      }
      .logo-dark {
        display: inline-block !important;
      }
      [data-theme="light"] .logo-light {
        display: inline-block !important;
      }
      [data-theme="light"] .logo-dark {
        display: none !important;
      }

      .nav__buttons {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 10px;
      }
      .nav__buttons .button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 24px;
        background: transparent;
        border: 1px solid var(--card-border);
        border-radius: 8px;
        color: var(--text-main);
        text-decoration: none;
        transition: all 0.2s ease;
        font-weight: 600;
        font-family: "Outfit", sans-serif; /* Fuente en botones */
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
      }
      .nav__buttons .button:hover {
        border-color: var(--brand-orange);
        color: var(--brand-orange);
        background: var(--button-hover-bg);
      }

      .download-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px;
        max-width: 1000px;
        margin: 40px auto;
        padding: 0 20px;
      }
      .dl-card {
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: 30px 20px;
        text-align: center;
        background-color: var(--card-bg);
        color: inherit;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 380px;
        transition: all 0.3s ease;
        position: relative;
      }
      .dl-card:hover {
        border-color: var(--brand-orange);
        transform: translateY(-6px);
        box-shadow: 0 15px 30px -10px rgba(249, 115, 22, 0.2);
        background-color: var(--button-hover-bg);
      }
      .dl-card:hover .icon-svg-platform {
        fill: var(--brand-orange);
        opacity: 1;
      }

      .dl-card.recommended {
        border: 2px solid var(--brand-orange);
        background-color: rgba(249, 115, 22, 0.08);
        box-shadow: 0 0 25px rgba(249, 115, 22, 0.15);
      }
      [data-theme="light"] .dl-card.recommended {
        background-color: rgba(249, 115, 22, 0.15);
      }

      .badge-rec {
        display: none;
        position: absolute;
        top: -14px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--brand-orange);
        color: #000;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
      }
      .dl-card.recommended .badge-rec {
        display: block;
      }

      .icon-wrapper {
        margin-bottom: 20px;
        display: flex;
        justify-content: center;
        color: inherit;
      }
      .icon-svg-platform {
        width: 50px;
        height: 50px;
        fill: currentColor;
        opacity: 0.8;
        transition: fill 0.3s;
      }

      .dl-title {
        font-size: 1.6rem;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 10px;
        letter-spacing: 1px;
      }
      .dl-info {
        font-size: 0.95rem;
        opacity: 0.8;
        line-height: 1.6;
        flex-grow: 1;
        margin-bottom: 20px;
      }
      .dl-info strong {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
        opacity: 1;
        color: var(--text-main);
      }

      .btn-group {
        display: flex;
        gap: 10px;
        margin-top: auto;
        justify-content: center;
      }
      .btn-dl {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 14px 10px;
        border: 1px solid var(--card-border);
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 700;
        color: inherit;
        transition: all 0.2s;
        cursor: pointer;
        white-space: nowrap;
        max-width: 140px;
        font-family: "Outfit", sans-serif;
        letter-spacing: 0.5px;
      }
      .btn-dl svg {
        width: 16px;
        height: 16px;
      }
      .btn-dl:hover {
        color: var(--brand-orange);
        border-color: var(--brand-orange);
        background-color: rgba(249, 115, 22, 0.1);
      }

      .recommended .btn-dl {
        border-color: var(--brand-orange);
        background: rgba(249, 115, 22, 0.2);
      }
      .recommended .btn-dl:hover {
        background-color: var(--brand-orange);
        color: black;
        box-shadow: 0 0 15px rgba(249, 115, 22, 0.4);
      }

      .hidden {
        display: none !important;
      }
      .icon-dl {
        width: 18px;
        height: 18px;
        fill: currentColor;
      }

      .footer__buttons a {
        color: var(--text-main);
        transition: color 0.3s;
        display: inline-block;
      }
      .footer__buttons a:hover {
        color: var(--brand-orange);
      }
    </style>
  </head>

  <body>
    <div class="notification">
      <a
        id="notification-link"
        href="https://github.com/sogik/NMCLauncher/releases"
        >Checking latest release...</a
      >
    </div>

    <button id="theme-toggle" aria-label="Toggle Dark/Light Mode">
      <svg id="icon-sun" viewBox="0 0 24 24"
        ><path
          d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 000-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 000-1.41.996.996 0 00-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 000 1.41.996.996 0 001.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06z"
        ></path></svg
      >
      <svg id="icon-moon" viewBox="0 0 24 24" style="display:none;"
        ><path
          d="M9.37 5.51A7.35 7.35 0 009.1 7.5c0 4.08 3.32 7.4 7.4 7.4.68 0 1.35-.09 1.99-.27C17.45 17.16 14.93 19 12 19c-4.41 0-8-3.59-8-8 0-3.2 2.11-5.98 5.37-7.49zM12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"
        ></path></svg
      >
    </button>

    <div style="text-align: center; padding: 30px 20px 10px 20px;">
      <a href="/">
        <Image
          src={darkLogo}
          alt="NMCLauncher Logo"
          width={800}
          height={200}
          class="logo-img logo-dark"
          loading="eager"
          fetchpriority="high"
        />
        <Image
          src={lightLogo}
          alt="NMCLauncher Logo"
          width={800}
          height={200}
          class="logo-img logo-light"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>

    <nav class="nav">
      <div class="nav__buttons">
        <a class="button" href="https://prismlauncher.org/wiki/">
          <svg class="icon-dl" viewBox="0 0 32 32"
            ><path
              d="m0 4.49992c0-.3978.158025-.77931.439312-1.0606s.662798-.43931 1.060598-.43931h8.50549c2.4538 0 4.6337 1.17992 5.9996 3.00181.6982-.9334 1.6047-1.69085 2.6474-2.212 1.0426-.52115 2.1926-.7916 3.3582-.78981h8.4895c.3978 0 .7793.15802 1.0606.43931s.4393.6628.4393 1.0606v20.99868c0 .3978-.158.7793-.4393 1.0606s-.6628.4393-1.0606.4393h-9.0134c-.591 0-1.1761.1164-1.722.3425-.546.2261-1.042.5576-1.4598.9754l-1.244 1.2419c-.2812.2809-.6624.4387-1.0599.4387s-.7787-.1578-1.0599-.4387l-1.244-1.2419c-.4178-.4178-.9138-.7493-1.4598-.9754-.5459-.2261-1.131-.3425-1.722-.3425h-9.01539c-.3978 0-.779311-.158-1.060598-.4393s-.439312-.6628-.439312-1.0606zm14.5011 20.64668.008-10.1453-.004-4.5058c-.0011-1.19267-.4756-2.33616-1.3194-3.17916-.8437-.84299-1.9876-1.31652-3.1803-1.31652h-7.00559v17.99888h7.51349c1.4108-.0001 2.793.3978 3.9878 1.1479zm3.0078-14.6471-.008 14.6431c1.1942-.7477 2.5748-1.1442 3.9838-1.1439h7.5135v-17.99888h-6.9896c-1.1934 0-2.3379.47408-3.1818 1.31794-.8438.84386-1.3179 1.98838-1.3179 3.18174z"
              fill="currentColor"></path></svg
          >
          <span>Manual</span>
        </a>
        <a class="button" href="https://github.com/sogik/NMCLauncher">
          <svg class="icon-dl" viewBox="0 0 32 32"
            ><path
              d="m16 0c8.84 0 16 7.16 16 16-.0009 3.3524-1.053 6.6201-3.0083 9.3432-1.9553 2.7232-4.7154 4.7645-7.8917 5.8368-.8.16-1.1-.34-1.1-.76 0-.54.02-2.26.02-4.4 0-1.5-.5-2.46-1.08-2.96 3.56-.4 7.3-1.76 7.3-7.9 0-1.76-.62-3.18-1.64-4.3.16-.4.72-2.04-.16-4.24 0 0-1.34-.44-4.4 1.64-1.28-.36-2.64-.54-4-.54s-2.72.18-4 .54c-3.06-2.06-4.4-1.64-4.4-1.64-.88 2.2-.32 3.84-.16 4.24-1.02 1.12-1.64 2.56-1.64 4.3 0 6.12 3.72 7.5 7.28 7.9-.46.4-.88 1.1-1.02 2.14-.92.42-3.22 1.1-4.66-1.32-.3-.48-1.2-1.66-2.46-1.64-1.34.02-.54.76.02 1.06.68.38 1.46 1.8 1.64 2.26.32.9 1.36 2.62 5.38 1.88 0 1.34.02 2.6.02 2.98 0 .42-.3.9-1.1.76-3.18672-1.0607-5.95853-3.098-7.92222-5.8227-1.96369-2.7248-3.01954096-5.9987-3.0177778-9.3573 0-8.84 7.1599978-16 15.9999978-16z"
              fill="currentColor"></path></svg
          >
          <span>GitHub</span>
        </a>
      </div>
    </nav>

    <main class="main">
      <section class="download-grid" aria-label="Download options">
        <article class="dl-card recommended" id="card-windows">
          <div class="badge-rec">Recommended</div>
          <div class="icon-wrapper">
            <svg class="icon-svg-platform" viewBox="0 0 24 24"
              ><path
                d="M0 3.449L9.75 2.1v9.451H0zm10.949-1.554L24 0v11.4H10.949zm-10.949 11.4H9.75V21.9L0 20.551zm10.949 0H24V24L10.949 22.101z"
              ></path></svg
            >
          </div>
          <h2 class="dl-title">Windows</h2>
          <div class="dl-info">
            <p><strong id="ver-win">Checking...</strong></p>
            <p id="arch-win">Detecting...</p>
          </div>
          <div class="btn-group">
            <a href="#" class="btn-dl hidden" id="btn-win-setup">⬇ Setup</a>
            <a href="#" class="btn-dl hidden" id="btn-win-port">⬇ Portable</a>
          </div>
        </article>

        <article class="dl-card" id="card-macos">
          <div class="badge-rec">Recommended</div>
          <div class="icon-wrapper">
            <svg
              class="icon-svg-platform"
              viewBox="0 0 24 24"
              style="transform: translateY(-2px);"
              ><path
                d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.5 1.3-.03 2.52.87 3.31.87.76 0 2.17-.91 3.67-.77 1.25.13 2.39.67 3.12 1.72-2.69 1.63-2.25 4.95.44 6.61-.64 1.87-1.52 3.66-2.69 4.96zm-3.22-15.9c1.32-1.61 2.2-3.87 2.2-5.97-1.92.07-4.26 1.28-5.62 2.9-1.18 1.39-2.2 3.6-1.94 5.72 2.15.17 4.34-1.22 5.36-2.65z"
              ></path></svg
            >
          </div>
          <h2 class="dl-title">MacOS</h2>
          <div class="dl-info">
            <p><strong id="ver-mac">Coming Soon™</strong></p>
            <p>Apple Silicon / Intel</p>
          </div>
          <div class="btn-group">
            <a href="#" class="btn-dl hidden" id="btn-mac-dl">⬇ Download</a>
          </div>
        </article>

        <article class="dl-card" id="card-linux">
          <div class="badge-rec">Recommended</div>
          <div class="icon-wrapper">
            <svg class="icon-svg-platform" viewBox="0 0 24 24"
              ><path
                d="M19.41 11.04C19.79 10.4 20 9.71 20 9a5 5 0 0 0-10 0c0 .71.21 1.4.59 2.04C6.67 12.58 3 16.11 3 21h18c0-4.89-3.67-8.42-7.59-9.96zM15 9c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-6 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z"
              ></path></svg
            >
          </div>
          <h2 class="dl-title">Linux</h2>
          <div class="dl-info">
            <p><strong id="ver-lin">Checking...</strong></p>
            <p>AppImage / Archive</p>
          </div>
          <div class="btn-group">
            <a href="#" class="btn-dl hidden" id="btn-lin-appimage"
              >⬇ AppImage</a
            >
            <a href="#" class="btn-dl hidden" id="btn-lin-tar">⬇ tar.gz</a>
          </div>
        </article>
      </section>
    </main>

    <footer class="footer">
      <div class="footer__subhead">
        <p>
          Made by <a
            href="https://x.com/sogikz"
            style="color: var(--brand-orange);">sogik</a
          >
        </p>
      </div>
      <div class="footer__buttons">
        <a href="https://github.com/sogik/NMCLauncher" aria-label="GitHub">
          <svg
            fill="none"
            height="32"
            viewBox="0 0 32 32"
            width="32"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              d="m16 0c8.84 0 16 7.16 16 16-.0009 3.3524-1.053 6.6201-3.0083 9.3432-1.9553 2.7232-4.7154 4.7645-7.8917 5.8368-.8.16-1.1-.34-1.1-.76 0-.54.02-2.26.02-4.4 0-1.5-.5-2.46-1.08-2.96 3.56-.4 7.3-1.76 7.3-7.9 0-1.76-.62-3.18-1.64-4.3.16-.4.72-2.04-.16-4.24 0 0-1.34-.44-4.4 1.64-1.28-.36-2.64-.54-4-.54s-2.72.18-4 .54c-3.06-2.06-4.4-1.64-4.4-1.64-.88 2.2-.32 3.84-.16 4.24-1.02 1.12-1.64 2.56-1.64 4.3 0 6.12 3.72 7.5 7.28 7.9-.46.4-.88 1.1-1.02 2.14-.92.42-3.22 1.1-4.66-1.32-.3-.48-1.2-1.66-2.46-1.64-1.34.02-.54.76.02 1.06.68.38 1.46 1.8 1.64 2.26.32.9 1.36 2.62 5.38 1.88 0 1.34.02 2.6.02 2.98 0 .42-.3.9-1.1.76-3.18672-1.0607-5.95853-3.098-7.92222-5.8227-1.96369-2.7248-3.01954096-5.9987-3.0177778-9.3573 0-8.84 7.1599978-16 15.9999978-16z"
              fill="currentColor"></path></svg
          >
        </a>
      </div>
    </footer>

    <script src="../scripts/main.ts"></script>
  </body>
</html>
